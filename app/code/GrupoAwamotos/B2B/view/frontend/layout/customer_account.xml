<?xml version="1.0"?>
<!--
/**
 * Customer Account Layout - Add B2B Links to sidebar navigation
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <!-- Painel B2B -->
            <block class="GrupoAwamotos\B2B\Block\Link\Dashboard"
                   name="customer-account-navigation-b2b-dashboard-link">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Painel B2B</argument>
                    <argument name="path" xsi:type="string">b2b/account/dashboard</argument>
                    <argument name="sortOrder" xsi:type="number">5</argument>
                </arguments>
            </block>
            <!-- Pedido Rápido -->
            <block class="GrupoAwamotos\B2B\Block\Link\QuickOrder"
                   name="customer-account-navigation-quickorder-link">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Pedido Rápido</argument>
                    <argument name="path" xsi:type="string">b2b/quickorder</argument>
                    <argument name="sortOrder" xsi:type="number">15</argument>
                </arguments>
            </block>
            <!-- Minhas Cotações -->
            <block class="GrupoAwamotos\B2B\Block\Link\QuickOrder"
                   name="customer-account-navigation-b2b-quotes-link">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Minhas Cotações</argument>
                    <argument name="path" xsi:type="string">b2b/quote/history</argument>
                    <argument name="sortOrder" xsi:type="number">20</argument>
                </arguments>
            </block>
            <!-- Listas de Compras -->
            <block class="GrupoAwamotos\B2B\Block\Link\QuickOrder"
                   name="customer-account-navigation-b2b-shoppinglist-link">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Listas de Compras</argument>
                    <argument name="path" xsi:type="string">b2b/shoppinglist</argument>
                    <argument name="sortOrder" xsi:type="number">25</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
