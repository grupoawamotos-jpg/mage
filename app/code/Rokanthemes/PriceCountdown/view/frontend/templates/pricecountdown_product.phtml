<?php
$helper = $this->helper('Rokanthemes\PriceCountdown\Helper\Data');
$toDate = $helper->getConfigData('pricecountdown/product_page/end_date_p_v');
$fromDate = $helper->getConfigData('pricecountdown/product_page/from_date_p_v');
$currentTimestamp = time();
$product = $block->getProduct();

if (strtotime($toDate) >= $currentTimestamp) {
	if ($product->getTypeId() != 'configurable' && $product->getTypeId() != 'grouped' && $product->getTypeId() != 'bundle') {
		$stockItem = $product->getExtensionAttributes()->getStockItem();
		$stocks = ($stockItem->getQty() > 0) ? $stockItem->getQty() : 100;

		$percentSold = $this->helper('Rokanthemes\RokanBase\Helper\Data')->getSalableQuantityDataBySku($product->getSku());
		$stockSummary = ($stocks - $percentSold) . '/' . $percentSold;

		$identifier = preg_replace('/[^A-Za-z0-9_-]/', '', (string)$block->getNameInLayout());
		if ($identifier === '') {
			$identifier = uniqid('pricecountdown_');
		}
		$containerId = 'pricecountdown-' . $identifier;

		$countdownConfig = [
			'countdownSelector' => '#countbox-p-p-c-container',
			'endDate' => $toDate ? date('c', strtotime($toDate)) : null,
			'startDate' => $fromDate ? date('c', strtotime($fromDate)) : null,
			'currentTime' => date('c', $currentTimestamp),
			'step' => -1,
			'labels' => [
				'days' => (string)__('Days'),
				'hours' => (string)__('Hours'),
				'minutes' => (string)__('Minutes'),
				'seconds' => (string)__('Seconds')
			],
			'finishMessage' => ''
		];
?>
<div class="countdown-page-product-custom" id="<?php echo $containerId; ?>">
	<div class="des-countdown-p-p-c"><?php echo str_replace('%s', $stockSummary, $helper->getConfigData('pricecountdown/product_page/messages_p_v')); ?></div>
	<div class="progressbar-countdown-parent">
		<div class="progressbar-countdown-p-p-c"><div style="width: <?php echo (($stocks - $percentSold) / $stocks) * 100 ; ?>%;"></div></div>
	</div>
	<div id="countbox-p-p-c-container"></div>
</div>
<script type="text/x-magento-init">
{
	"#<?php echo $containerId; ?>": {
		"Rokanthemes_PriceCountdown/js/product-countdown": <?php echo json_encode($countdownConfig, JSON_UNESCAPED_SLASHES); ?>
	}
}
</script>
<?php } } ?>