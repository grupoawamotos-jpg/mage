# Magento 2 .gitignore

# Arquivos de configuração sensíveis
/app/etc/env.php
/app/etc/config.php
auth.json

# Cache e arquivos temporários
/var/*
!/var/.htaccess
/pub/media/*
!/pub/media/.htaccess
!/pub/media/customer
!/pub/media/downloadable
!/pub/media/import
!/pub/media/theme_customization
/pub/static/*
!/pub/static/.htaccess

# Arquivos gerados
/generated/*
!/generated/.htaccess

# Dependências (gerenciadas pelo Composer)
/vendor/

# Logs
*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Node modules (se usar frontend build)
node_modules/

# Backup files
*.bak
*.backup
*.sql
*.gz
*.zip

# OpenSearch data e logs (não versionar)
/opensearch/opensearch-2.12.0/data/
/opensearch/opensearch-2.12.0/logs/

# MacOS lixo
__MACOSX/
._.DS_Store
._*

# Trae IDE
.trae/
backup_pre_update_20251130/
biblioteca/modulos_backup_*.tgz

# OpenSearch binários grandes (>100MB) - não versionar
/opensearch/opensearch-2.12.0/jdk/
/opensearch/opensearch-2.12.0/plugins/opensearch-ml/
/opensearch/opensearch-2.12.0/modules/ingest-geoip/
